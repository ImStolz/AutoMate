rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reglas para imágenes de vehículos
    match /vehicles/{userId}/{vehicleId}/{fileName} {
      allow read, write: if request.auth != null && 
                        request.auth.uid == userId &&
                        // Verificar que el archivo sea una imagen
                        resource.contentType.matches('image/.*') &&
                        // Limitar tamaño a 5MB
                        resource.size < 5 * 1024 * 1024;
    }
    
    // Reglas para imágenes de recibos/facturas
    match /receipts/{userId}/{expenseId}/{fileName} {
      allow read, write: if request.auth != null && 
                        request.auth.uid == userId &&
                        resource.contentType.matches('image/.*') &&
                        resource.size < 10 * 1024 * 1024; // 10MB para recibos
    }
    
    // Reglas para imágenes de mantenimiento
    match /maintenance/{userId}/{maintenanceId}/{fileName} {
      allow read, write: if request.auth != null && 
                        request.auth.uid == userId &&
                        resource.contentType.matches('image/.*') &&
                        resource.size < 10 * 1024 * 1024;
    }
    
    // Reglas para fotos de perfil
    match /profiles/{userId}/{fileName} {
      allow read, write: if request.auth != null && 
                        request.auth.uid == userId &&
                        resource.contentType.matches('image/.*') &&
                        resource.size < 2 * 1024 * 1024; // 2MB para fotos de perfil
    }
    
    // Denegar acceso a cualquier otro archivo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
